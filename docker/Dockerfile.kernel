# The editing model's Python kernel: CPU only, run with --network none. The packages the task message promises:
# numpy, scipy, scikit-learn, PyTorch (CPU), pandas, sympy, networkx, safetensors, tokenizers.
FROM python:3.12-slim
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir numpy==2.1.3 scipy==1.14.1 scikit-learn==1.5.2 pandas==2.2.3 sympy==1.13.1 \
        networkx==3.4.2 safetensors==0.4.5 tokenizers==0.20.3
COPY weight_space_bench/math_edit/kernel_server.py /opt/weight_space_bench/kernel_server.py
WORKDIR /work
