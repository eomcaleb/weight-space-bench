# Driver + forward-pass tool + evaluation (vLLM and transformers on the GPU). Needs a vLLM build that supports
# Qwen3.5 (Qwen3_5ForCausalLM, gated DeltaNet); pin VLLM_IMAGE to the tag you validated with `weight_space_bench check`.
ARG VLLM_IMAGE=vllm/vllm-openai:latest
FROM ${VLLM_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends docker.io && rm -rf /var/lib/apt/lists/*
COPY requirements-math-edit.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
ENTRYPOINT []
